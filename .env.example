# =====================================================================
# Cuaderno los Nazco — Configuración para Producción Real
# Sin estas variables, la aplicación funciona en Modo Demo Local + WebRTC P2P
# =====================================================================

# 1. Backend / Base de datos (elige Supabase o Firebase)
VITE_BACKEND_PROVIDER=local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# 2. Almacenamiento de archivos (S3 / Cloudflare R2 / Firebase Storage)
VITE_MEDIA_CDN_BASE_URL=

# 3. Señalización WebRTC y servidores TURN para videollamadas en redes estrictas (4G/CGNAT)
VITE_SIGNALING_SERVER_URL=
VITE_TURN_URL=turn:turn.tudominio.com:3478
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
